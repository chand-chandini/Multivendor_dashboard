{
  "name": "multivendor_backend",
  "version": "1.0.0",
  "description": "Multivendor platform backend",
  "main": "app.js",
  "scripts": {
    "start": "nodemon app.js",
    "test": "jest --runInBand",
    "migrate:public": "node public_app/scripts/migrate.js",
    "seed:local-home": "node public_app/scripts/seed-local-home.js",
    "seed:local-paneer": "node public_app/scripts/seed-local-paneer.js",
    "seed:local-categories": "node public_app/scripts/seed-local-categories.js",
    "seed:local-rajamundry": "node public_app/scripts/seed-local-rajamundry.js",
    "disable:local-rajahmundry": "node public_app/scripts/disable-local-rajahmundry.js",
    "images:optimize-local": "python public_app/scripts/optimize-local-images.py",
    "bootstrap:local": "node public_app/scripts/bootstrap-local-db.js"
  },
  "nodemonConfig": {
    "watch": [
      "app.js",
      "config",
      "dashboard_api",
      "notification",
      "partner_app",
      "public_app",
      "socket",
      "super_admin",
      "utils",
      "validators"
    ],
    "ext": "js,json",
    "ignore": [
      "uploads/*",
      "tmp/*",
      "static/*",
      "database/*",
      "*.log"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aws-sdk": "^2.243.1",
    "axios": "^0.21.4",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-http-to-https": "^1.1.4",
    "express-useragent": "^1.0.8",
    "express-validator": "^5.3.0",
    "forever": "^0.15.3",
    "forever-monitor": "^1.7.1",
    "ioredis": "^4.9.0",
    "jsonwebtoken": "^8.2.2",
    "md5": "^2.2.1",
    "moment": "^2.22.2",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "mysql": "^2.18.1",
    "node-cron": "^3.0.2",
    "node-schedule": "^1.3.3",
    "nodemailer": "^4.7.0",
    "nodemon": "^1.17.3",
    "pdfkit": "0.10.0",
    "querystring": "^0.2.0",
    "razorpay": "^1.0.0",
    "request": "^2.88.0",
    "socket.io": "^4.8.3",
    "unirest": "^0.6.0",
    "wysiwyg-editor-node-sdk": "^2.3.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.0"
  }
}
