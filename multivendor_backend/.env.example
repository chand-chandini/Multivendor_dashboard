# Copy to .env and fill in. Only the names are listed here, never real values.
PORT=2407
MV_USE_HTTPS=0
MV_PUBLIC_ORIGIN=http://192.168.0.114:2407
MV_DB_NAME=multivendor_db
MV_PUBLIC_LOG_OTP=0
MV_SMS_ENABLED=0
MV_SMS_API_URL=https://sms.sunstechit.com/app/smsapi/index.php
MV_SMS_API_KEY=
MV_SMS_CAMPAIGN=0
MV_SMS_ROUTE_ID=13
MV_SMS_SENDER_ID=GDWOTP
MV_SMS_TEMPLATE_ID=1207173899985649979
MV_SMS_TIMEOUT_MS=10000
# Enable the public_html upload directory and production image URLs on the server.
# NODE_ENV=production
# Production image uploads are written to ../../public_html/upload_files by default.
# Set these on the server if its webroot is at a different absolute path.
# MV_UPLOADS_DIR=/absolute/path/to/public_html/upload_files
# MV_UPLOADS_BASE_URL=https://ekart360.in/upload_files
